# ilcd workflow. Each rule runs one `ilcd <module> <command>`; rules live in rules/<module>.smk and are added as the
# modules are implemented (docs/runbook.md). Data paths come from ilcd.common.paths, never from strings here.
#
# Wildcards (docs/design.md sections 3-4):
#   {file_id}  per legacy file   files/{file_id}/...
#   {cell_id}  per 1 km cell     cells/{cell_id}/...
#   {scope}    region:<name> or statewide
#   {site}     per site          sites/{site}/...
#
# Usage:  snakemake --profile config/profiles/<machine> --config region=carroll <target>
import os

from ilcd.common import config as ilcd_config

if "ILCD_DATA_ROOT" not in os.environ:
    raise WorkflowError("set ILCD_DATA_ROOT (docs/runbook.md)")

REGION = config.get("region")
if REGION is not None:
    ilcd_config.load_region(REGION)  # fails early on a bad region file

