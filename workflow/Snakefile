# ilcd workflow. Each rule runs one `ilcd <module> <command>`; rules live in rules/<module>.smk and are added as the
# modules are implemented (docs/runbook.md). Data paths come from ilcd.common.paths, never from strings here.
#
# Wildcards (docs/design.md sections 3-4):
#   {file_id}  per legacy file   files/{file_id}/...
#   {cell_id}  per 1 km cell     cells/{cell_id}/...
#   {scope}    region:<name> or statewide
#   {site}     per site          sites/{site}/...
#   {delivery} per delivery      statewide/deliveries/{delivery}/...
#
# Usage:  snakemake --profile config/profiles/<machine> statewide_catalog        (once, before any region)
#         snakemake --profile config/profiles/<machine> --config region=carroll <target>
import os

from ilcd.common import config as ilcd_config
from ilcd.common import paths as ilcd_paths

if "ILCD_DATA_ROOT" not in os.environ:
    raise WorkflowError("set ILCD_DATA_ROOT (docs/runbook.md)")

REGION = config.get("region")
if REGION is not None:
    ilcd_config.load_region(REGION)  # fails early on a bad region file
if (REGION is not None or config.get("site") is not None) and not (
    ilcd_paths.data_root() / "statewide" / ".catalog.done"
).exists():
    raise WorkflowError("the statewide catalog stage has not finished: run `jobs/snakemake.sh statewide catalog` first")
SITE = config.get("site")
if SITE is not None:
    ilcd_config.load_site(SITE)

include: "rules/statewide.smk"      # catalogs, every legacy file, headers, datum, deliveries (once)
include: "rules/upper.smk"          # data_src -> flightlines -> refs -> align -> eval (refactor step 2)
include: "rules/change.smk"         # DoD, M3C2, objects of a site (refactor step 4)
# include: "rules/viz_label.smk"
# include: "rules/baselines.smk"     (refactor step 5)


rule config_check:
    """Validate every region, site and delivery override."""
    shell:
        "ilcd config check"
